{
  "redirects": [
    {"source":"/work","destination":"/","permanent":true},
    {"source":"/work/","destination":"/","permanent":true},
    {"source":"/insights","destination":"/blog/","permanent":true},
    {"source":"/insights/","destination":"/blog/","permanent":true},
    {"source":"/insights/:path*","destination":"/blog/:path*","permanent":true}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"geolocation=(), microphone=(), camera=()"}]}
  ]
}
